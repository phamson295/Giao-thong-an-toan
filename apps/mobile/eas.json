{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.example.vn",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.example.vn",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
      }
    }
  }
}
