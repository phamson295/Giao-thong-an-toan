# Sao chép file này thành .env (cùng thư mục) rồi sửa địa chỉ.
# Máy ảo Android: 10.0.2.2 là địa chỉ của máy tính đang chạy máy ảo.
# Điện thoại thật: thay bằng địa chỉ IP của máy tính trong mạng WiFi (xem bằng lệnh ipconfig).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
